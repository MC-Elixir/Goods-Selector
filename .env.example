# ============================================================
# Amazon Selector - 环境变量配置模板
# 复制本文件为 .env 并填入实际值：cp .env.example .env
# ============================================================

# ---------- 数据库 ----------
# 默认使用 SQLite，无需修改
# DATABASE_URL=sqlite:///data/amazon_selector.db

# ---------- 视觉/LLM 模型（必填其一） ----------
# PPIO（派噢）— OpenAI 兼容接口，国内访问快（优先）
PPIO_API_KEY=
# PPIO_API_BASE=https://api.ppio.com/openai
# PPIO_MODEL=qwen/qwen3.5-plus
# PPIO_TEXT_MODEL=minimax/minimax-m3
# LLM_REQUEST_TIMEOUT_SECONDS=30.0

# Anthropic — Claude Vision（PPIO 未配置时的备用）
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-6

# ---------- Amazon 数据源 ----------
# Keepa 价格历史 API（https://keepa.com）
KEEPA_API_KEY=
# Rainforest API（https://www.rainforestapi.com）
RAINFOREST_API_KEY=
# Amazon 站点：US / UK / DE / JP
# AMAZON_MARKETPLACE=US

# ---------- 1688 Open Platform（默认关闭，浏览器为生产路径） ----------
# 置 true 启用 Open API 匹配器（需配合下方三项密钥）
ENABLE_ALIBABA_OPEN_API_MATCHER=false
# ALIBABA_APP_KEY=
# ALIBABA_APP_SECRET=
# ALIBABA_ACCESS_TOKEN=
# ALIBABA_API_GATEWAY=https://gw.open.1688.com/openapi/
# ALIBABA_SUPPLIER_SEARCH_NAMESPACE=com.alibaba.pifatuan
# ALIBABA_SUPPLIER_SEARCH_METHOD=alibaba.pifatuan.product.list
# ALIBABA_SUPPLIER_SEARCH_KEYWORD_PARAM=keywords
# ALIBABA_SUPPLIER_SEARCH_CANDIDATES=

# ---------- 卖家精灵 (SellerSprite) ----------
# 别名：SELLERSPRITE_API_KEY / SELLER_SPRITE_API_KEY / SELLERSPRITE_KEY
MJJL_API_KEY=
# MJJL_API_BASE=https://api.sellersprite.com/v1
# MJJL_MAX_PRODUCTS_PER_RUN=3

# ---------- 卖家精灵浏览器导出 ----------
# SELLERSPRITE_BROWSER_ENABLED=true
# SELLERSPRITE_BROWSER_LOCATOR_PROFILE_PATH=
# SELLERSPRITE_BROWSER_DOWNLOAD_DIR=
# SELLERSPRITE_BROWSER_HOST_DOWNLOAD_DIR=
# SELLERSPRITE_BROWSER_PAGE_TIMEOUT_SECONDS=45
# SELLERSPRITE_BROWSER_EXPORT_TIMEOUT_SECONDS=120
# SELLERSPRITE_BROWSER_MIN_INTERVAL_SECONDS=5
# SELLERSPRITE_BROWSER_MAX_RETRIES=1

# ---------- Chrome DevTools (CDP) ----------
# 用于浏览器代理连接本地 Chrome 远程调试端口
# BU_CDP_HTTP=http://127.0.0.1:9222
# BU_CDP_WS=ws://127.0.0.1:9222/devtools/browser/<id>

# ---------- 行为开关 ----------
# API 缓存
# ENABLE_API_CACHE=true
# LLM 视觉验证（对比 Amazon 和 1688 商品图片）
# ENABLE_LLM_VERIFICATION=false
# LLM_VERIFICATION_TOP_K=2
# LLM_VERIFICATION_MIN_MATCH_QUALITY=0.65
# LLM_VERIFICATION_MIN_SPEC_SCORE=0.50
# 目标品类 LLM 筛选 Top-K
# TARGET_CATEGORY_LLM_TOP_K=5
# TARGET_CATEGORY_DETAIL_ENRICH_LIMIT=10
# TARGET_CATEGORY_EXHAUSTIVE_QUERIES=true
# 1688 Scrapling 匹配器（默认禁用，被反爬拦截）
# ENABLE_SCRAPLING_MATCHER=false
# 1688 结果缓存 TTL（秒，默认 7 天）
# ALIBABA_REAL_RESULT_CACHE_TTL_SECONDS=604800
# ALIBABA_DETAIL_ENRICH_LIMIT=2
# ALIBABA_DETAIL_CACHE_TTL_SECONDS=604800
# 1688 反爬冷却（秒）
# ALIBABA_BLOCK_COOLDOWN_SECONDS=900
# 正式运行禁止 mock 供应商（smoke-run --allow-mock 可临时开启）
# ALIBABA_ALLOW_MOCK_SUPPLIERS=false

# ---------- Pipeline 超时（秒） ----------
# PIPELINE_CRAWL_TIMEOUT_SECONDS=300
# PIPELINE_MATCH_TIMEOUT_SECONDS=900
# PIPELINE_PROFIT_TIMEOUT_SECONDS=300
# PIPELINE_MARKET_TIMEOUT_SECONDS=300
# PIPELINE_SCORE_TIMEOUT_SECONDS=300
# PIPELINE_EXPORT_TIMEOUT_SECONDS=120

# ---------- 浏览器代理 ----------
# BROWSER_AGENT_ALLOWED_DOMAINS=amazon.com,www.amazon.com,1688.com,detail.1688.com,s.1688.com,127.0.0.1,localhost

# ---------- 通用 ----------
# 缓存 TTL（秒）
# CACHE_TTL_SECONDS=86400
# 日志级别：DEBUG / INFO / WARNING / ERROR
# LOG_LEVEL=INFO
# 自定义日志目录（留空则使用 data/logs）
# LOG_DIR=
