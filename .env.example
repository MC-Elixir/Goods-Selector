# ====================================================
# Amazon Selector - 环境变量配置
# 复制为 .env 后填写真实值，.env 不要提交到 git
# ====================================================

# ---------- 数据库 ----------
# 开发期 SQLite
DATABASE_URL=sqlite:///./data/amazon_selector.db
# 生产 PostgreSQL 示例
# DATABASE_URL=postgresql://user:password@localhost:5432/amazon_selector

# ---------- Amazon 数据源（任选其一）----------
# Keepa API
KEEPA_API_KEY=

# Rainforest API（备用）
RAINFOREST_API_KEY=

# ---------- 1688 拍立淘官方 API ----------
# 阿里巴巴开放平台 https://open.1688.com/
ALIBABA_APP_KEY=
ALIBABA_APP_SECRET=
ALIBABA_ACCESS_TOKEN=
# 沙箱 / 正式环境
ALIBABA_API_GATEWAY=https://gw.open.1688.com/openapi/

# ---------- 卖家精灵 API ----------
MJJL_API_KEY=
MJJL_API_BASE=https://api.sellersprite.com/v1

# ---------- 行为开关 ----------
# 本地开发建议开启缓存避免重复扣费
ENABLE_API_CACHE=true
CACHE_TTL_SECONDS=86400

# 日志级别
LOG_LEVEL=INFO

# 默认 Amazon 站点
AMAZON_MARKETPLACE=US
